# Kopier til .env og fyll inn. .env skal ALDRI committes.

# --- Azure SQL (påkrevd) ---
UNG_AZURESQL_ODBC=Driver={ODBC Driver 18 for SQL Server};Server=tcp:digiung.database.windows.net,1433;Database=UngNo_QA;Uid=digiung;Pwd=<PASSORD>;Encrypt=yes;TrustServerCertificate=no;

# --- Azure OpenAI chat (steg 4, navngir topics) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<ressurs>.openai.azure.com/
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=

# --- Azure OpenAI embeddings (steg 4, klynging) ---
AZURE_OPENAI_EMBEDDINGS_API_KEY=
AZURE_OPENAI_EMBEDDINGS_ENDPOINT=https://<ressurs>.openai.azure.com/
AZURE_OPENAI_EMBEDDINGS_API_VERSION=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=

# --- Valgfritt ---
# HF_TOKEN=                       # kun ved rate limiting mot Hugging Face ved bygg/lokal kjøring
# QA_MAX_AGE_MONTHS=12            # 0 = behold alt
# RUN_TOPIC_CATEGORIZATION=1
# RUN_PSA_SSA_CATEGORIZATION=1
# RUN_WEEKLY_TOPIC_DISCOVERY=1
# FORCE_RECATEGORIZE_PSA_SSA=0    # 1 = re-kategoriser alle PSA/SSA-rader (etter endring i psa_ssa_topics.json)
# DISCOVERY_WEEKS=1
# DISCOVERY_OVERWRITE=0
# LOG_LEVEL=INFO
